    "other_geometries": ["POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))"],  // A list of geometries that will be included when making the model domain bounding box
    "domain_buffer": 100.0,  // An additional buffer for the model domain. Since the reach centerline will already be buffered by 10x bankfull width to generate the domain, 0 is typically appropriate.
    "grid_resolution": 10.0,  // Resolution that grid will snap to and that DEM and roughness will resample to
    "walk_us_dist_pct": 0.25,  // How far to walk up the upstream mainstem centerline to place the inflow boundary condition, as percent of upstream centerline length
    "epsg_code": 5070,  // EPSG integer for all georeferenced output artifacts
    "bankfull_width_multiplier": 1.0,  // How much to multiply bankfull width to arrive at inflow line width
    "lulc_lookup": {
      "11": 0.04,
      "21": 0.04,
      "31": 0.025,
      "41": 0.16,
      "82": 0.035
    }  // A dictionary mapping land use codes to Manning's roughness values
  },
  "domain": {
    "bbox": [-2059240.0, 2806980.0, -2055870.0, 2810760.0],  // Domain bbox in native CRS [west, south, east, north].
    "anchor": [-2058170.0, 2809120.0],  // Grid-snapped reach centroid in native CRS [x, y]; origin the offsets are measured from.
    "offsets": [164.0, 214.0, 230.0, 107.0]  // [N, S, E, W] grid-snapped offsets in CRS units; matches domain_token.
  },
  "identity": {
    "sdr_commit": "a1b2c3d4",  // Methodology version pin (output-determining).
    "reach_geom_hash": "fceb20c6",  // Hash of WKT representation of reach geometry
    "grid_resolution": 10.0,  // Model horizontal resolution
    "epsg_code": 5070,  // EPSG integer that model will be created in
    "dem_source_inputs_hash": "a1b2c3d4",  // Hash of connection parameters to roughness dataset
    "lulc_source_inputs_hash": "e5f6a7b8",  // Hash of connection parameters to lulc dataset
